// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

enum StockUnit {
  PIECE
  GRAM
  ML
}

model Admin {
  id           Int           @id @default(autoincrement())
  username     String        @unique
  password     String
  refreshToken RefreshToken?
}

model RefreshToken {
  id      Int    @id @default(autoincrement())
  token   String
  admin   Admin  @relation(fields: [adminId], references: [id], onDelete: Cascade)
  adminId Int    @unique
}

model Item {
  id           Int        @id @default(autoincrement())
  name         String
  description  String?
  unit         StockUnit
  price        Decimal    @db.Decimal(12, 2)
  priceBasis   Int        @default(1)
  packName     String?
  packSize     Int?
  reorderLevel Int        @default(0)
  isActive     Boolean    @default(true)

  batches             Batch[]
  saleLines           SaleLine[]
  saleReturnLines     SaleReturnLine[]
  purchaseLines       PurchaseLine[]
  purchaseReturnLines PurchaseReturnLine[]
  StockAdjustments    StockAdjustment[]
}

model Batch {
  id           Int      @id @default(autoincrement())
  itemId       Int
  item         Item     @relation(fields: [itemId], references: [id])
  expiryDate   DateTime @db.Date
  unitCost     Decimal  @db.Decimal(14, 6)
  qtyReceived  Int
  qtyRemaining Int

  saleLineBatches     SaleLineBatch[]
  saleReturnLines     SaleReturnLine[]
  purchaseLines       PurchaseLine[]
  purchaseReturnLines PurchaseReturnLine[]
  stockAdjustments    StockAdjustment[]

  @@unique([itemId, expiryDate, unitCost])
}

model Customer {
  id             Int       @id @default(autoincrement())
  name           String
  phone          String    @default("")
  openingBalance Decimal   @default(0) @db.Decimal(12, 2)
  isActive       Boolean   @default(true)

  sales          Sale[]
  saleReturns    SaleReturn[]
  payments       Payment[]
}

model Sale {
  id         Int        @id @default(autoincrement())
  customerId Int?
  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  date       DateTime   @default(now())
  discount   Decimal    @default(0) @db.Decimal(12, 2)
  total      Decimal    @default(0) @db.Decimal(12, 2)
  paid       Decimal    @default(0) @db.Decimal(12, 2)
  note       String?

  lines      SaleLine[]
  returns    SaleReturn[]

  @@index([customerId, date])
}

model SaleLine {
  id          Int       @id @default(autoincrement())
  saleId      Int
  sale        Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  itemId      Int
  item        Item      @relation(fields: [itemId], references: [id])
  baseQty     Int
  unitPrice   Decimal   @db.Decimal(14, 6)
  lineTotal   Decimal   @db.Decimal(12, 2)

  batches     SaleLineBatch[]
}

model SaleLineBatch {
  id          Int       @id @default(autoincrement())
  saleLineId  Int
  saleLine    SaleLine  @relation(fields: [saleLineId], references: [id], onDelete: Cascade)
  batchId     Int
  batch       Batch     @relation(fields: [batchId], references: [id])
  baseQty     Int
  unitCost    Decimal   @db.Decimal(14, 6)

  returnLines  SaleReturnLine[]
}

model SaleReturn {
  id          Int        @id @default(autoincrement())
  customerId  Int?
  customer    Customer?  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  saleId      Int?
  sale        Sale?      @relation(fields: [saleId], references: [id], onDelete: Restrict)
  date        DateTime   @default(now())
  total       Decimal    @default(0) @db.Decimal(12, 2)
  cashRefund  Decimal    @default(0) @db.Decimal(12, 2)
  note        String?

  lines       SaleReturnLine[]
}

model SaleReturnLine {
  id              Int              @id @default(autoincrement())
  returnId        Int
  saleReturn      SaleReturn       @relation(fields: [returnId], references: [id], onDelete: Cascade)
  itemId          Int
  item            Item             @relation(fields: [itemId], references: [id])
  batchId         Int
  batch           Batch            @relation(fields: [batchId], references: [id])
  saleLineBatchId Int?
  saleLineBatch   SaleLineBatch?   @relation(fields: [saleLineBatchId], references: [id], onDelete: Restrict)
  baseQty         Int
  unitPrice       Decimal          @db.Decimal(14, 6)
  lineTotal       Decimal          @db.Decimal(12, 2)
}

model Supplier {
  id             Int       @id @default(autoincrement())
  name           String
  phone          String    @default("")
  openingBalance Decimal   @default(0) @db.Decimal(12, 2)
  isActive       Boolean   @default(true)

  purchases         Purchase[]
  purchaseReturns   PurchaseReturn[]
  payments          Payment[]
}

model Purchase {
  id         Int        @id @default(autoincrement())
  supplierId Int
  supplier   Supplier   @relation(fields: [supplierId], references: [id])
  date       DateTime   @default(now())
  discount   Decimal    @default(0) @db.Decimal(12, 2)
  total      Decimal    @default(0) @db.Decimal(12, 2)
  paid       Decimal    @default(0) @db.Decimal(12, 2)
  note       String?

  lines             PurchaseLine[]
  purchaseReturns   PurchaseReturn[]

  @@index([supplierId, date])
}

model PurchaseLine {
  id          Int       @id @default(autoincrement())
  purchaseId  Int
  purchase    Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  itemId      Int
  item        Item      @relation(fields: [itemId], references: [id])
  baseQty     Int
  lineTotal   Decimal   @db.Decimal(12, 2)
  batchId     Int
  batch       Batch     @relation(fields: [batchId], references: [id])
}

model PurchaseReturn {
  id          Int        @id @default(autoincrement())
  supplierId  Int
  supplier    Supplier   @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseId  Int?
  purchase    Purchase?  @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  date        DateTime   @default(now())
  total       Decimal    @default(0) @db.Decimal(12, 2)
  cashRefund  Decimal    @default(0) @db.Decimal(12, 2)
  note        String?

  lines       PurchaseReturnLine[]
}

model PurchaseReturnLine {
  id              Int                 @id @default(autoincrement())
  returnId        Int
  purchaseReturn  PurchaseReturn      @relation(fields: [returnId], references: [id], onDelete: Cascade)
  itemId          Int
  item            Item                @relation(fields: [itemId], references: [id])
  batchId         Int
  batch           Batch               @relation(fields: [batchId], references: [id])
  baseQty         Int
  lineTotal       Decimal             @db.Decimal(12, 2)
}

model Payment {
  id         Int       @id @default(autoincrement())
  customerId Int?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  supplierId Int?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  amount     Decimal   @db.Decimal(12, 2)
  date       DateTime  @default(now())
  note       String?

  @@index([customerId, date])  
  @@index([supplierId, date])
}

model Expense {
  id       Int      @id @default(autoincrement())
  date     DateTime @default(now())
  category String
  amount   Decimal  @db.Decimal(12, 2)
  note     String?

  @@index([date])
}


model StockAdjustment {
  id       Int      @id @default(autoincrement())
  date     DateTime @default(now())
  itemId   Int
  item     Item     @relation(fields: [itemId], references: [id])
  batchId  Int
  batch    Batch    @relation(fields: [batchId], references: [id])
  baseQty  Int
  reason   String?
}