generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model Admin {
  id           Int           @id @default(autoincrement())
  username     String        @unique
  password     String
  refreshToken RefreshToken?
}

model RefreshToken {
  id      Int    @id @default(autoincrement())
  token   String
  admin   Admin  @relation(fields: [adminId], references: [id], onDelete: Cascade)
  adminId Int    @unique
}